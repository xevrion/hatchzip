<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded in hatchzip-gui.exe by build.rs. It runs with the user's own
  rights and never asks for an administrator's, it is written for Windows 10
  and 11, and it draws sharply on every monitor's scale (Per-Monitor V2, the
  mode winit would otherwise set when it starts). Windows and antivirus
  engines read all three; without a manifest, Windows guesses.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
