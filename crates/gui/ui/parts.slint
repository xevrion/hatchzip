import { Button, CheckBox, LineEdit, ProgressIndicator, Spinner, Palette } from "std-widgets.slint";
import { Theme, Meter } from "theme.slint";

export enum Phase {
    // Nothing running: the main window shows its settings and buttons.
    idle,
    checking,
    verifying,
    working,
    pausing,
    paused,
    done,
    failed,
    no-space,
}

export struct PlanView {
    ready: bool,
    free: string,
    // Required when the archive is kept, as for any extractor.
    normal: string,
    // Required when the archive is removed during extraction.
    in-place: string,
    // The plan is for keeping the archive.
    keep-archive: bool,
    needed: string,
    keep: string,
    after: string,
    fits: bool,
    verdict: string,
    note: string,
    meter: float,
}

export struct TaskView {
    phase: Phase,
    is-test: bool,
    heading: string,
    detail: string,
    // "Archive 2 of 3" when a right-click queued several.
    step: string,
    // What the spinner says while checking: "Checking disk space…", or
    // "Reading archive… 37%" while a long open reads through it.
    busy: string,
    // "Required: 3.5 MB. Available: 7.7 GB.", once the space is checked.
    space: string,
    fraction: float,
    amounts: string,
    rate: string,
    archive-left: string,
    message: string,
    can-open-folder: bool,
    can-retry: bool,
    // Paused or stopped halfway: offer to undo it.
    can-give-back: bool,
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> strong;
    spacing: 12px;
    Text {
        text: root.label;
        color: Theme.muted;
        horizontal-stretch: 1;
        overflow: elide;
    }
    Text {
        text: root.value;
        horizontal-alignment: right;
        font-weight: root.strong ? 600 : 400;
    }
}

// What the disk looks like before, during and after. Plain numbers first,
// the verdict last, so the eye lands on the answer.
export component SpacePanel inherits VerticalLayout {
    in property <PlanView> plan;
    padding: Theme.gutter;
    spacing: 10px;
    alignment: start;

    Text {
        text: @tr("Disk space");
        font-weight: 600;
    }
    if !root.plan.ready: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Spinner {
            indeterminate: true;
            width: 16px;
            height: 16px;
        }
        Text {
            text: @tr("Calculating…");
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
    if root.plan.ready: VerticalLayout {
        spacing: 8px;
        Row {
            label: @tr("Available");
            value: root.plan.free;
        }
        // Both ways, the chosen one in bold, so the difference the archive
        // makes is in plain view.
        Row {
            label: @tr("Required, archive removed");
            value: root.plan.in-place;
            strong: !root.plan.keep-archive;
        }
        Row {
            label: @tr("Required, archive kept");
            value: root.plan.normal;
            strong: root.plan.keep-archive;
        }
        Row {
            label: @tr("Reserved");
            value: root.plan.keep;
        }
        Row {
            label: @tr("Available after extraction");
            value: root.plan.after;
        }
        Rectangle {
            height: 4px;
        }
        Meter {
            value: root.plan.meter;
            bad: !root.plan.fits;
        }
        Text {
            text: root.plan.verdict;
            wrap: word-wrap;
            font-weight: 600;
            color: root.plan.fits ? Palette.foreground : Theme.danger;
        }
        if root.plan.note != "": Text {
            text: root.plan.note;
            wrap: word-wrap;
            color: Theme.muted;
            font-size: Theme.small-size;
        }
    }
}

// The bar and numbers of a run. Shared by the main window and the small task
// window, so both read the same.
export component Progress inherits VerticalLayout {
    in property <TaskView> task;
    spacing: 8px;

    ProgressIndicator {
        progress: root.task.fraction;
        indeterminate: root.task.phase == Phase.checking;
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.task.amounts;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.task.rate;
            color: Theme.muted;
            horizontal-alignment: right;
        }
    }
    if root.task.archive-left != "": Text {
        text: root.task.archive-left;
        color: Theme.muted;
        font-size: Theme.small-size;
    }
}

// The message under a finished, paused or failed run.
export component Outcome inherits Text {
    in property <TaskView> task;
    text: root.task.message;
    wrap: word-wrap;
    color: root.task.phase == Phase.failed || root.task.phase == Phase.no-space ? Theme.danger : Palette.foreground;
}

export component Busy inherits HorizontalLayout {
    in property <string> text;
    alignment: start;
    spacing: 8px;
    Spinner {
        indeterminate: true;
        width: 16px;
        height: 16px;
    }
    Text {
        text: root.text;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

export component TaskButtons inherits HorizontalLayout {
    in property <TaskView> task;
    // The task window offers Close; the main window has its own way out.
    in property <bool> closable;
    callback pause();
    callback resume();
    callback open-folder();
    callback close();
    callback back();
    callback give-back();

    alignment: end;
    spacing: 8px;

    if root.task.can-give-back: Button {
        text: @tr("Restore archive");
        clicked => {
            root.give-back();
        }
    }

    if !root.closable && (root.task.phase == Phase.paused || root.task.phase == Phase.failed || root.task.phase == Phase.no-space || (root.task.phase == Phase.done && !root.task.can-open-folder)): Button {
        text: @tr("Back");
        clicked => {
            root.back();
        }
    }
    // Checking and testing are safe to cut short, so they can be cancelled.
    if root.closable && root.task.phase != Phase.working && root.task.phase != Phase.pausing: Button {
        text: root.task.phase == Phase.checking || root.task.phase == Phase.verifying ? @tr("Cancel") : @tr("Close");
        clicked => {
            root.close();
        }
    }
    if root.task.phase == Phase.working || root.task.phase == Phase.pausing: Button {
        text: root.task.phase == Phase.pausing ? @tr("Pausing…") : @tr("Pause");
        enabled: root.task.phase == Phase.working;
        clicked => {
            root.pause();
        }
    }
    if root.task.phase == Phase.paused: Button {
        text: @tr("Resume");
        primary: true;
        clicked => {
            root.resume();
        }
    }
    if root.task.can-retry && (root.task.phase == Phase.failed || root.task.phase == Phase.no-space): Button {
        text: root.task.phase == Phase.no-space ? @tr("Check again") : @tr("Retry");
        clicked => {
            root.resume();
        }
    }
    if root.task.phase == Phase.done && root.task.can-open-folder: Button {
        text: @tr("Open folder");
        primary: true;
        clicked => {
            root.open-folder();
        }
    }
}

// Asks for an archive's password over the whole window, so nothing else can
// be clicked while it is up. A new one is made for every question, so the
// field starts empty and focused.
export component PasswordPrompt inherits Rectangle {
    in property <string> name;
    in property <bool> wrong;
    callback ok(string);
    callback cancel();

    background: Theme.scrim;
    // Swallows clicks meant for what is underneath.
    TouchArea { }

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(380px, root.width - 32px);
            height: card.preferred-height;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;

            card := VerticalLayout {
                padding: Theme.gutter;
                spacing: 10px;
                Text {
                    text: @tr("Password required");
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: @tr("Enter the password for {}.", root.name);
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                input := LineEdit {
                    input-type: password;
                    placeholder-text: @tr("Password");
                    accepted(text) => {
                        root.ok(text);
                    }
                }
                if root.wrong: Text {
                    text: @tr("Incorrect password.");
                    color: Theme.danger;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.cancel();
                        }
                    }
                    Button {
                        text: @tr("OK");
                        primary: true;
                        clicked => {
                            root.ok(input.text);
                        }
                    }
                }
            }
        }
    }

    init => {
        input.focus();
    }
}

// Asks, before anything is touched, what to do with a file already in the
// destination folder, one file at a time until the person answers for the
// rest. Laid out like the password prompt.
export component ReplacePrompt inherits Rectangle {
    in property <string> text;
    // What each answer does.
    in property <string> note;
    // The offer to answer for the files after this one; empty for the last.
    in property <string> rest;
    in-out property <bool> for-rest;
    // 0 replace, 1 skip, 2 keep both, and whether it is for the rest too.
    callback answer(int, bool);
    callback cancel();

    background: Theme.scrim;
    // Swallows clicks meant for what is underneath.
    TouchArea { }

    scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if event.text == Key.Return {
                root.answer(0, root.for-rest);
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(440px, root.width - 32px);
            height: card.preferred-height;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;

            card := VerticalLayout {
                padding: Theme.gutter;
                spacing: 8px;
                Text {
                    text: @tr("Replace or skip files");
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: root.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.note;
                    color: Theme.muted;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                }
                if root.rest != "": CheckBox {
                    text: root.rest;
                    checked <=> root.for-rest;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.cancel();
                        }
                    }
                    Button {
                        text: @tr("Keep both");
                        clicked => {
                            root.answer(2, root.for-rest);
                        }
                    }
                    Button {
                        text: @tr("Skip");
                        clicked => {
                            root.answer(1, root.for-rest);
                        }
                    }
                    Button {
                        text: @tr("Replace");
                        primary: true;
                        clicked => {
                            root.answer(0, root.for-rest);
                        }
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
