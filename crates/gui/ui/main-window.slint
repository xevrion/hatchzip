import { Button, CheckBox, LineEdit, ListView, Palette } from "std-widgets.slint";
import { Theme, Line, VLine, FolderIcon, FileIcon, DropIcon } from "theme.slint";
import { Phase, PlanView, TaskView, SpacePanel, Progress, Outcome, Busy, TaskButtons, PasswordPrompt, ReplacePrompt } from "parts.slint";

export enum Screen { empty, loading, opened, error }

// Fresh: nothing extracted yet. Resume: a run stopped halfway. Orphan: every
// file is out and only the side files are left to clean up.
export enum Mode { fresh, resume, orphan }

export struct EntryRow {
    name: string,
    size: string,
    dir: bool,
}

component EntryList inherits VerticalLayout {
    in property <[EntryRow]> entries;
    in property <string> empty-text;

    Rectangle {
        height: 30px;
        background: Theme.panel;
        HorizontalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            spacing: 8px;
            Text {
                text: @tr("Name");
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: @tr("Size");
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 90px;
            }
        }
    }
    Line { }
    if root.entries.length == 0: Rectangle {
        Text {
            text: root.empty-text;
            color: Theme.muted;
        }
    }
    if root.entries.length > 0: ListView {
        for row in root.entries: Rectangle {
            height: 26px;
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                spacing: 8px;
                if row.dir: FolderIcon {
                    y: (parent.height - self.height) / 2;
                }
                if !row.dir: FileIcon {
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: row.name;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: row.size == "link" ? @tr("link") : row.size;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 90px;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <Screen> screen: Screen.empty;
    in property <Mode> mode: Mode.fresh;
    in property <bool> drop-hover;
    in property <string> archive-name;
    // Shown instead of "Opening…" once opening has read through the archive
    // for a while: "Reading archive… 37%".
    in property <string> loading-detail;
    in property <string> summary;
    in property <string> error-text;
    in property <[EntryRow]> entries;
    in property <PlanView> plan;
    in property <string> output;
    in-out property <string> keep-free: "2";
    in property <bool> keep-free-valid: true;
    out property <string> storage-unit: @tr("GB");
    in-out property <bool> verify-first;
    // Off keeps the archive: a standard extraction that removes nothing.
    in-out property <bool> remove-archive: true;
    // For the small window a right-click opens, not this one.
    in-out property <bool> close-when-done: true;
    // The formats line under the Open button; RAR only in builds with it.
    in property <bool> supports-rar;
    in property <string> formats: root.supports-rar ? @tr("Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, RAR, and split archives.") : @tr("Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, and split archives.");
    // The half-extracted run being resumed keeps its archive.
    in property <bool> kept-run;
    in property <TaskView> task;
    in property <bool> password-shown;
    in property <bool> password-wrong;
    in property <string> password-name;
    in property <bool> replace-shown;
    in property <string> replace-text;
    in property <string> replace-note;
    in property <string> replace-rest;
    // The right-click menu setting exists where hatchzip-shell supports it.
    in property <bool> shell-menu-available;
    // Names the file manager where the platform has one name for it.
    in property <string> shell-menu-label;
    in-out property <bool> shell-menu-on;
    // A short message at the bottom of the window, such as the outcome of
    // changing the right-click menu.
    in property <string> notice;
    in property <bool> notice-bad;

    public function shell-explorer() -> string { return @tr("Show in the Explorer context menu"); }
    public function shell-files() -> string { return @tr("Show in the file manager's context menu"); }
    public function shell-finder() -> string { return @tr("Show in the Finder context menu"); }
    public function open-archive-title() -> string { return @tr("Open archive"); }
    public function archives-filter() -> string { return @tr("Archives"); }
    public function all-files-filter() -> string { return @tr("All files"); }
    public function destination-title() -> string { return @tr("Select destination folder"); }
    public function menu-added() -> string { return @tr("Context menu entries added."); }
    public function menu-removed() -> string { return @tr("Context menu entries removed."); }
    public function no-entries() -> string { return @tr("No entries remaining"); }
    public function checking-space() -> string { return @tr("Checking disk space…"); }
    public function restore-detail() -> string { return @tr("Converting it back to a standard archive. Extracted files are kept."); }
    public function test-detail() -> string { return @tr("Verifying every entry. No files are written."); }
    public function pausing-message() -> string { return @tr("Pausing after the current batch…"); }
    public function verifying-message() -> string { return @tr("Verifying archive before extracting…"); }
    public function paused-message() -> string { return @tr("Progress is saved. The extraction can be resumed now or later."); }
    public function extracted-kept() -> string { return @tr("All entries were extracted. The archive was kept."); }
    public function extracted-removed() -> string { return @tr("All entries were extracted. The archive was removed."); }
    public function test-one() -> string { return @tr("Test passed: 1 entry verified."); }
    public function waiting-disk() -> string { return @tr("Waiting for disk"); }

    public function reading-archive(percent: int) -> string { return @tr("Reading archive… {}%", percent); }
    public function archive-kind(name: string) -> string { return @tr("{} archive", name); }
    public function entry-count(number: string, one: bool) -> string { return one ? @tr("{} entry", number) : @tr("{} entries", number); }
    public function remaining-summary(size: string, entries: string) -> string { return @tr("{} in {} remaining", size, entries); }
    public function uncompressed-summary(size: string) -> string { return @tr("{} uncompressed", size); }

    public function task-heading(phase: Phase, is-test: bool, restoring: bool, name: string) -> string {
        if (restoring) {
            if (phase == Phase.done) { return @tr("Restore complete"); }
            if (phase == Phase.failed) { return @tr("Restore failed"); }
            return @tr("Restoring {}", name);
        }
        if (is-test) {
            if (phase == Phase.done) { return @tr("Test complete"); }
            if (phase == Phase.failed) { return @tr("Test failed"); }
            return @tr("Testing {}", name);
        }
        if (phase == Phase.done) { return @tr("Extraction complete"); }
        if (phase == Phase.paused) { return @tr("Extraction paused"); }
        if (phase == Phase.failed) { return @tr("Extraction failed"); }
        if (phase == Phase.no-space) { return @tr("Insufficient disk space"); }
        return @tr("Extracting {}", name);
    }

    public function task-destination(path: string) -> string { return @tr("Destination: {}", path); }
    public function task-amounts(done: string, total: string) -> string { return @tr("{} of {}", done, total); }
    public function task-archive-left(size: string) -> string { return @tr("Archive remaining: {}", size); }

    public function task-test-result(one: bool, count: string) -> string { return one ? @tr("Test passed: 1 entry verified.") : @tr("Test passed: {} entries verified.", count); }

    public function task-rate(speed: string, time: string) -> string { return @tr("{}/s, {} remaining", speed, time); }
    public function time-short() -> string { return @tr("less than 5 seconds"); }
    public function time-seconds(one: bool, n: string) -> string { return one ? @tr("{} second", n) : @tr("{} seconds", n); }
    public function time-minutes(one: bool, n: string) -> string { return one ? @tr("{} minute", n) : @tr("{} minutes", n); }
    public function time-hours(one: bool, n: string) -> string { return one ? @tr("{} hour", n) : @tr("{} hours", n); }

    public function restore-held(one: bool, n: string) -> string { return one ? @tr("the 1 entry") : @tr("the {} entries", n); }
    public function restore-result(kept: bool, held: string, path: string) -> string { return kept ? @tr("Extraction progress discarded. The archive was not modified. Extracted files remain in {}.", path) : @tr("Archive restored. It contains {} not yet extracted. Extracted files remain in {}.", held, path); }
    public function restore-aside(one: bool, n: string, path: string) -> string { return one ? @tr("1 replaced file remains in {}, since the file extracted at its path is no longer in the archive.", path) : @tr("{} replaced files remain in {}, since the files extracted at their paths are no longer in the archive.", n, path); }

    public function task-resumable-error(reason: string) -> string { return @tr("{} Progress is saved; the extraction can be resumed.", reason); }

    callback open-archive();
    callback password-ok(string);
    callback password-cancel();
    public function replace-question(file: string, folder: string) -> string { return @tr("'{}' already exists in {}.", file, folder); }
    public function replace-instructions(removing: bool) -> string { return removing ? @tr("Replace deletes the existing file when the extraction completes. Skip keeps it, and the archive's copy is not kept. Keep both keeps it and adds the archive's copy with a number after its name.") : @tr("Replace deletes the existing file when the extraction completes. Skip keeps it. Keep both keeps it and adds the archive's copy with a number after its name."); }
    public function replace-remaining(left: int, count: string) -> string { return left == 0 ? "" : left == 1 ? @tr("Do the same for the next file") : @tr("Do the same for the next {} files", count); }

    callback replace-answer(int, bool);
    callback replace-cancel();
    callback shell-menu-toggled();
    callback give-back();
    callback verify-first-toggled();
    callback remove-archive-toggled();
    callback close-when-done-toggled();
    callback change-output();
    callback keep-free-edited(string);
    callback extract();
    callback test();
    callback pause();
    callback resume();
    callback open-folder();
    callback back();
    callback about();
    callback check-for-updates();
    callback quit();

    title: root.screen == Screen.opened ? root.archive-name + " - HatchZip" : "HatchZip";
    preferred-width: 980px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 440px;
    background: Palette.background;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Open…");
                shortcut: @keys(Control + O);
                enabled: root.task.phase == Phase.idle || root.task.phase == Phase.done;
                activated => {
                    root.open-archive();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                activated => {
                    root.quit();
                }
            }
        }
        Menu {
            title: @tr("Settings");
            if root.shell-menu-available: MenuItem {
                title: root.shell-menu-label;
                checkable: true;
                checked <=> root.shell-menu-on;
                activated => {
                    root.shell-menu-toggled();
                }
            }
            MenuItem {
                title: @tr("Verify archive before extracting");
                checkable: true;
                checked <=> root.verify-first;
                activated => {
                    root.verify-first-toggled();
                }
            }
            MenuItem {
                title: @tr("Remove the archive during extraction");
                checkable: true;
                checked <=> root.remove-archive;
                activated => {
                    root.remove-archive-toggled();
                }
            }
            MenuItem {
                title: @tr("Close the progress window when extraction completes");
                checkable: true;
                checked <=> root.close-when-done;
                activated => {
                    root.close-when-done-toggled();
                }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Check for updates");
                activated => {
                    root.check-for-updates();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About HatchZip");
                activated => {
                    root.about();
                }
            }
        }
    }

    if root.screen == Screen.empty: Rectangle {
        background: root.drop-hover ? Theme.panel : transparent;
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                DropIcon { }
            }
            Text {
                text: root.drop-hover ? @tr("Drop the archive to open it") : @tr("No archive open");
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("The archive is removed progressively during extraction, so only the space for the extracted files is required.");
                color: Theme.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 6px;
                Button {
                    text: @tr("Open archive…");
                    primary: true;
                    clicked => {
                        root.open-archive();
                    }
                }
            }
            Text {
                text: root.formats;
                wrap: word-wrap;
                color: Theme.faint;
                font-size: Theme.small-size;
                horizontal-alignment: center;
            }
        }
        // The same switch as in the Settings menu, where a first-time user
        // looks: most will use HatchZip from the right-click menu.
        if root.shell-menu-available: HorizontalLayout {
            y: parent.height - self.height - 20px;
            height: self.preferred-height;
            alignment: center;
            CheckBox {
                text: root.shell-menu-label;
                checked <=> root.shell-menu-on;
                toggled => {
                    root.shell-menu-toggled();
                }
            }
        }
    }

    if root.screen == Screen.loading: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Busy {
                text: root.loading-detail != "" ? root.loading-detail : @tr("Opening {}…", root.archive-name);
            }
        }
    }

    if root.screen == Screen.error: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 40px;
        Text {
            text: @tr("Unable to open {}", root.archive-name);
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.error-text;
            color: Theme.muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            Button {
                text: @tr("Open another archive…");
                clicked => {
                    root.open-archive();
                }
            }
        }
    }

    if root.screen == Screen.opened: VerticalLayout {
        // Header: what this archive is.
        VerticalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            padding-top: 16px;
            padding-bottom: 14px;
            spacing: 4px;
            Text {
                text: root.archive-name;
                font-size: Theme.title-size;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.summary;
                color: Theme.muted;
                overflow: elide;
            }
        }
        Line { }

        HorizontalLayout {
            vertical-stretch: 1;
            EntryList {
                horizontal-stretch: 1;
                entries: root.entries;
                empty-text: root.mode == Mode.orphan ? @tr("All entries have been extracted.") : @tr("This archive is empty.");
            }
            VLine { }
            SpacePanel {
                width: 260px;
                plan: root.plan;
            }
        }
        Line { }

        // Footer: settings and the buttons, or the run in progress.
        if root.task.phase == Phase.idle: VerticalLayout {
            padding: Theme.gutter;
            padding-top: 14px;
            spacing: 12px;

            if root.mode == Mode.resume || root.mode == Mode.orphan: Text {
                text: root.mode == Mode.resume ? @tr("This archive is partially extracted to {}.", root.output) + (root.kept-run ? @tr(" The archive is kept.") : "") : @tr("All entries have been extracted to {}. Select Finish to remove the remaining temporary files.", root.output);
                wrap: word-wrap;
                font-weight: 600;
            }

            if root.mode == Mode.fresh: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Extract to");
                    vertical-alignment: center;
                    width: 112px;
                }
                LineEdit {
                    text: root.output;
                    read-only: true;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Browse…");
                    clicked => {
                        root.change-output();
                    }
                }
            }

            if root.mode != Mode.orphan: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Reserved space");
                    vertical-alignment: center;
                    width: 112px;
                }
                LineEdit {
                    width: 72px;
                    text <=> root.keep-free;
                    input-type: decimal;
                    horizontal-alignment: right;
                    edited(text) => {
                        root.keep-free-edited(text);
                    }
                }
                Text {
                    text: root.keep-free-valid ? root.storage-unit : @tr("GB. Enter a number, such as 2 or 0.5.");
                    vertical-alignment: center;
                    color: root.keep-free-valid ? Palette.foreground : Theme.danger;
                }
                Rectangle {
                    width: 16px;
                }
                if root.mode == Mode.fresh: CheckBox {
                    text: @tr("Verify archive before extracting");
                    checked <=> root.verify-first;
                    toggled => {
                        root.verify-first-toggled();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            // Lined up with the fields above, under their labels' column.
            if root.mode == Mode.fresh: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 112px;
                }
                CheckBox {
                    text: @tr("Remove the archive during extraction");
                    checked <=> root.remove-archive;
                    toggled => {
                        root.remove-archive-toggled();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.mode != Mode.fresh ? "" : root.remove-archive ? @tr("The archive is removed progressively during extraction. An interrupted extraction can be resumed.") : @tr("The archive is kept unchanged, so space is required for all extracted files. An interrupted extraction can be resumed.");
                    color: Theme.muted;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.mode == Mode.fresh: Button {
                    text: @tr("Test");
                    clicked => {
                        root.test();
                    }
                }
                // A kept archive was never changed; there is nothing to restore.
                if root.mode == Mode.resume && !root.kept-run: Button {
                    text: @tr("Restore archive");
                    clicked => {
                        root.give-back();
                    }
                }
                Button {
                    text: root.mode == Mode.fresh ? @tr("Extract") : (root.mode == Mode.resume ? @tr("Resume extraction") : @tr("Finish"));
                    primary: true;
                    enabled: root.mode == Mode.orphan || (root.plan.ready && root.plan.fits && root.keep-free-valid);
                    clicked => {
                        root.extract();
                    }
                }
            }
        }

        if root.task.phase != Phase.idle: VerticalLayout {
            padding: Theme.gutter;
            padding-top: 14px;
            spacing: 10px;
            Text {
                text: root.task.heading;
                font-weight: 600;
                overflow: elide;
            }
            if root.task.phase == Phase.checking: Busy {
                text: root.task.busy;
            }
            if root.task.phase == Phase.verifying || root.task.phase == Phase.working || root.task.phase == Phase.pausing || root.task.phase == Phase.paused: Progress {
                task: root.task;
            }
            HorizontalLayout {
                spacing: 12px;
                Outcome {
                    task: root.task;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                // The archive is gone after a successful run, so Back has
                // nothing to reopen; offer the same way out as the error
                // screen instead of leaving only the folder.
                if root.task.phase == Phase.done && root.task.can-open-folder: Button {
                    text: @tr("Open another archive…");
                    clicked => {
                        root.open-archive();
                    }
                }
                TaskButtons {
                    task: root.task;
                    closable: false;
                    pause => {
                        root.pause();
                    }
                    resume => {
                        root.resume();
                    }
                    open-folder => {
                        root.open-folder();
                    }
                    back => {
                        root.back();
                    }
                    give-back => {
                        root.give-back();
                    }
                }
            }
        }
    }

    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        // Above the footer's buttons and the right-click switch.
        y: 16px;
        width: min(notice-text.preferred-width + 32px, parent.width - 32px);
        height: notice-text.preferred-height + 20px;
        background: Palette.alternate-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        notice-text := Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.notice;
            wrap: word-wrap;
            vertical-alignment: center;
            color: root.notice-bad ? Theme.danger : Palette.foreground;
        }
    }

    if root.password-shown: PasswordPrompt {
        name: root.password-name;
        wrong: root.password-wrong;
        ok(text) => {
            root.password-ok(text);
        }
        cancel => {
            root.password-cancel();
        }
    }

    if root.replace-shown: ReplacePrompt {
        text: root.replace-text;
        note: root.replace-note;
        rest: root.replace-rest;
        answer(choice, rest) => {
            root.replace-answer(choice, rest);
        }
        cancel => {
            root.replace-cancel();
        }
    }
}
