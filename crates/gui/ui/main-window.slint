import { Button, CheckBox, LineEdit, ListView, Palette } from "std-widgets.slint";
import { Theme, Line, VLine, FolderIcon, FileIcon, DropIcon } from "theme.slint";
import { Phase, PlanView, TaskView, SpacePanel, Progress, Outcome, Busy, TaskButtons, PasswordPrompt } from "parts.slint";

export enum Screen { empty, loading, opened, error }

// Fresh: nothing extracted yet. Resume: a run stopped halfway. Orphan: every
// file is out and only the side files are left to clean up.
export enum Mode { fresh, resume, orphan }

export struct EntryRow {
    name: string,
    size: string,
    dir: bool,
}

component EntryList inherits VerticalLayout {
    in property <[EntryRow]> entries;
    in property <string> empty-text;

    Rectangle {
        height: 30px;
        background: Theme.panel;
        HorizontalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            spacing: 8px;
            Text {
                text: "Name";
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: "Size";
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 90px;
            }
        }
    }
    Line { }
    if root.entries.length == 0: Rectangle {
        Text {
            text: root.empty-text;
            color: Theme.muted;
        }
    }
    if root.entries.length > 0: ListView {
        for row in root.entries: Rectangle {
            height: 26px;
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                spacing: 8px;
                if row.dir: FolderIcon {
                    y: (parent.height - self.height) / 2;
                }
                if !row.dir: FileIcon {
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: row.name;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: row.size;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 90px;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <Screen> screen: Screen.empty;
    in property <Mode> mode: Mode.fresh;
    in property <bool> drop-hover;
    in property <string> archive-name;
    in property <string> summary;
    in property <string> error-text;
    in property <[EntryRow]> entries;
    in property <PlanView> plan;
    in property <string> output;
    in-out property <string> keep-free: "2";
    in property <bool> keep-free-valid: true;
    in-out property <bool> verify-first;
    in property <TaskView> task;
    in property <bool> password-shown;
    in property <bool> password-wrong;
    in property <string> password-name;
    // The right-click menu setting exists where hatchzip-shell supports it.
    in property <bool> shell-menu-available;
    // Names the file manager where the platform has one name for it.
    in property <string> shell-menu-label;
    in-out property <bool> shell-menu-on;
    // A short message at the bottom of the window, such as the outcome of
    // changing the right-click menu.
    in property <string> notice;
    in property <bool> notice-bad;

    callback open-archive();
    callback password-ok(string);
    callback password-cancel();
    callback shell-menu-toggled();
    callback give-back();
    callback verify-first-toggled();
    callback change-output();
    callback keep-free-edited(string);
    callback extract();
    callback test();
    callback pause();
    callback resume();
    callback open-folder();
    callback back();
    callback about();
    callback quit();

    title: root.screen == Screen.opened ? root.archive-name + " - HatchZip" : "HatchZip";
    preferred-width: 980px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 440px;
    background: Palette.background;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                enabled: root.task.phase == Phase.idle || root.task.phase == Phase.done;
                activated => {
                    root.open-archive();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                shortcut: @keys(Control + Q);
                activated => {
                    root.quit();
                }
            }
        }
        Menu {
            title: "Settings";
            if root.shell-menu-available: MenuItem {
                title: root.shell-menu-label;
                checkable: true;
                checked <=> root.shell-menu-on;
                activated => {
                    root.shell-menu-toggled();
                }
            }
            MenuItem {
                title: "Verify archive before extracting";
                checkable: true;
                checked <=> root.verify-first;
                activated => {
                    root.verify-first-toggled();
                }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "About HatchZip";
                activated => {
                    root.about();
                }
            }
        }
    }

    if root.screen == Screen.empty: Rectangle {
        background: root.drop-hover ? Theme.panel : transparent;
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                DropIcon { }
            }
            Text {
                text: root.drop-hover ? "Drop the archive to open it" : "No archive open";
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "The archive is removed progressively during extraction, so only the space for the extracted files is required.";
                color: Theme.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 6px;
                Button {
                    text: "Open archive…";
                    primary: true;
                    clicked => {
                        root.open-archive();
                    }
                }
            }
            Text {
                text: "Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, RAR, and split archives.";
                color: Theme.faint;
                font-size: Theme.small-size;
                horizontal-alignment: center;
            }
        }
        // The same switch as in the Settings menu, where a first-time user
        // looks: most will use HatchZip from the right-click menu.
        if root.shell-menu-available: HorizontalLayout {
            y: parent.height - self.height - 20px;
            height: self.preferred-height;
            alignment: center;
            CheckBox {
                text: root.shell-menu-label;
                checked <=> root.shell-menu-on;
                toggled => {
                    root.shell-menu-toggled();
                }
            }
        }
    }

    if root.screen == Screen.loading: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Busy {
                text: "Opening " + root.archive-name + "…";
            }
        }
    }

    if root.screen == Screen.error: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 40px;
        Text {
            text: "Unable to open " + root.archive-name;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.error-text;
            color: Theme.muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            Button {
                text: "Open another archive…";
                clicked => {
                    root.open-archive();
                }
            }
        }
    }

    if root.screen == Screen.opened: VerticalLayout {
        // Header: what this archive is.
        VerticalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            padding-top: 16px;
            padding-bottom: 14px;
            spacing: 4px;
            Text {
                text: root.archive-name;
                font-size: Theme.title-size;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.summary;
                color: Theme.muted;
                overflow: elide;
            }
        }
        Line { }

        HorizontalLayout {
            vertical-stretch: 1;
            EntryList {
                horizontal-stretch: 1;
                entries: root.entries;
                empty-text: root.mode == Mode.orphan ? "All entries have been extracted." : "This archive is empty.";
            }
            VLine { }
            SpacePanel {
                width: 260px;
                plan: root.plan;
            }
        }
        Line { }

        // Footer: settings and the buttons, or the run in progress.
        if root.task.phase == Phase.idle: VerticalLayout {
            padding: Theme.gutter;
            padding-top: 14px;
            spacing: 12px;

            if root.mode == Mode.resume || root.mode == Mode.orphan: Text {
                text: root.mode == Mode.resume ? "This archive is partially extracted to " + root.output + "." : "All entries have been extracted to " + root.output + ". Select Finish to remove the remaining temporary files.";
                wrap: word-wrap;
                font-weight: 600;
            }

            if root.mode == Mode.fresh: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Extract to";
                    vertical-alignment: center;
                    width: 112px;
                }
                LineEdit {
                    text: root.output;
                    read-only: true;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Browse…";
                    clicked => {
                        root.change-output();
                    }
                }
            }

            if root.mode != Mode.orphan: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Reserved space";
                    vertical-alignment: center;
                    width: 112px;
                }
                LineEdit {
                    width: 72px;
                    text <=> root.keep-free;
                    input-type: decimal;
                    horizontal-alignment: right;
                    edited(text) => {
                        root.keep-free-edited(text);
                    }
                }
                Text {
                    text: root.keep-free-valid ? "GB" : "GB. Enter a number, such as 2 or 0.5.";
                    vertical-alignment: center;
                    color: root.keep-free-valid ? Palette.foreground : Theme.danger;
                }
                Rectangle {
                    width: 16px;
                }
                if root.mode == Mode.fresh: CheckBox {
                    text: "Verify archive before extracting";
                    checked <=> root.verify-first;
                    toggled => {
                        root.verify-first-toggled();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.mode == Mode.fresh ? "The archive is removed progressively during extraction. An interrupted extraction can be resumed." : "";
                    color: Theme.muted;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.mode == Mode.fresh: Button {
                    text: "Test";
                    clicked => {
                        root.test();
                    }
                }
                if root.mode == Mode.resume: Button {
                    text: "Restore archive";
                    clicked => {
                        root.give-back();
                    }
                }
                Button {
                    text: root.mode == Mode.fresh ? "Extract" : (root.mode == Mode.resume ? "Resume extraction" : "Finish");
                    primary: true;
                    enabled: root.mode == Mode.orphan || (root.plan.ready && root.plan.fits && root.keep-free-valid);
                    clicked => {
                        root.extract();
                    }
                }
            }
        }

        if root.task.phase != Phase.idle: VerticalLayout {
            padding: Theme.gutter;
            padding-top: 14px;
            spacing: 10px;
            Text {
                text: root.task.heading;
                font-weight: 600;
                overflow: elide;
            }
            if root.task.phase == Phase.checking: Busy {
                text: "Checking disk space…";
            }
            if root.task.phase == Phase.verifying || root.task.phase == Phase.working || root.task.phase == Phase.pausing || root.task.phase == Phase.paused: Progress {
                task: root.task;
            }
            HorizontalLayout {
                spacing: 12px;
                Outcome {
                    task: root.task;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                TaskButtons {
                    task: root.task;
                    closable: false;
                    pause => {
                        root.pause();
                    }
                    resume => {
                        root.resume();
                    }
                    open-folder => {
                        root.open-folder();
                    }
                    back => {
                        root.back();
                    }
                    give-back => {
                        root.give-back();
                    }
                }
            }
        }
    }

    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        // Above the footer's buttons and the right-click switch.
        y: 16px;
        width: min(notice-text.preferred-width + 32px, parent.width - 32px);
        height: notice-text.preferred-height + 20px;
        background: Palette.alternate-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        notice-text := Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.notice;
            wrap: word-wrap;
            vertical-alignment: center;
            color: root.notice-bad ? Theme.danger : Palette.foreground;
        }
    }

    if root.password-shown: PasswordPrompt {
        name: root.password-name;
        wrong: root.password-wrong;
        ok(text) => {
            root.password-ok(text);
        }
        cancel => {
            root.password-cancel();
        }
    }
}
