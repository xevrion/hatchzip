import { Messages } from "messages.slint";
import { Button, CheckBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";
import { Theme, Line, VLine, FolderIcon, FileIcon, DropIcon } from "theme.slint";
import { Phase, PlanView, TaskView, SpacePanel, Progress, Outcome, Busy, TaskButtons, PasswordPrompt, ReplacePrompt } from "parts.slint";

export enum Screen { empty, loading, opened, error }

// Fresh: nothing extracted yet. Resume: a run stopped halfway. Orphan: every
// file is out and only the side files are left to clean up.
export enum Mode { fresh, resume, orphan }

export struct EntryRow {
    name: string,
    path: string,
    size: string,
    dir: bool,
    link: bool,
    expanded: bool,
    depth: int,
}

component EntryList inherits VerticalLayout {
    in property <[EntryRow]> entries;
    in property <string> empty-text;
    property <int> selected: 0;
    property <length> row-height: 26px;
    init => { scope.focus(); }
    callback toggle(int, int);
    function show-selection() {
        let y = list.content-y + root.selected * root.row-height;
        if y < 0px { list.content-y -= y; }
        if y + root.row-height > list.visible-height { list.content-y -= y + root.row-height - list.visible-height; }
    }

    Rectangle {
        height: 30px;
        background: Theme.panel;
        HorizontalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            spacing: 8px;
            Text {
                text: @tr("Name");
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: @tr("Size");
                color: Theme.muted;
                font-size: Theme.small-size;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 90px;
            }
        }
    }
    Line { }
    Rectangle {
        if root.entries.length == 0: Text {
            text: root.empty-text;
            color: Theme.muted;
        }
    list := ListView {
        for row[index] in root.entries: Rectangle {
            height: root.row-height;
            accessible-role: list-item;
            accessible-label: row.path;
            accessible-description: row.dir ? @tr("Folder") : row.link ? @tr("Link") : @tr("File");
            accessible-expandable: row.dir;
            accessible-expanded: row.expanded;
            accessible-item-selectable: true;
            accessible-item-selected: root.selected == index;
            accessible-action-default => { root.selected = index; scope.focus(); if row.dir { root.toggle(index, 0); } }
            accessible-action-expand => { root.selected = index; scope.focus(); if row.dir { root.toggle(index, 1); } }
            background: root.selected == index && scope.has-focus ? Palette.alternate-background : transparent;
            HorizontalLayout {
                padding-left: Theme.gutter + row.depth * 16px;
                padding-right: Theme.gutter;
                spacing: 8px;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    stroke: Theme.muted;
                    stroke-width: 1.4px;
                    fill: transparent;
                    commands: !row.dir ? "" : row.expanded ? "M 3 5 L 7 9 L 11 5" : "M 5 3 L 9 7 L 5 11";
                }
                if row.dir: FolderIcon {
                    y: (parent.height - self.height) / 2;
                }
                if !row.dir: FileIcon {
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: row.name;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: row.link ? @tr("link") : row.size;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 90px;
                }
            }
            TouchArea {
                clicked => {
                    root.selected = index;
                    scope.focus();
                    if row.dir { root.toggle(index, 0); }
                }
            }
        }
    }
    }
    scope := FocusScope {
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.selected = max(0, root.selected - 1); root.show-selection(); return accept; }
            if event.text == Key.DownArrow {
                if root.entries.length > 0 {
                    root.selected = min(root.entries.length - 1, root.selected + 1);
                    root.show-selection();
                }
                return accept;
            }
            if event.text == Key.LeftArrow { root.toggle(root.selected, -1); return accept; }
            if event.text == Key.RightArrow { root.toggle(root.selected, 1); return accept; }
            return reject;
        }
    }
}

export component MainWindow inherits Window {
    in property <Screen> screen: Screen.empty;
    in property <Mode> mode: Mode.fresh;
    in property <bool> drop-hover;
    in property <string> archive-name;
    // Shown instead of "Opening…" once opening has read through the archive
    // for a while: "Reading archive… 37%".
    in property <string> loading-detail;
    in property <string> summary;
    in property <string> error-text;
    in property <[EntryRow]> entries;
    in property <PlanView> plan;
    in property <string> output;
    in-out property <string> keep-free: "2";
    in property <bool> keep-free-valid: true;
    out property <string> storage-unit: @tr("GB");
    in-out property <bool> verify-first;
    // Off keeps the archive: a standard extraction that removes nothing.
    in-out property <bool> remove-archive: true;
    // For the small window a right-click opens, not this one.
    in-out property <bool> close-when-done: true;
    // The formats line under the Open button; RAR only in builds with it.
    in property <bool> supports-rar;
    in property <string> formats: root.supports-rar ? @tr("Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, tar.xz, RAR, and split archives.") : @tr("Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, tar.xz, and split archives.");
    // The half-extracted run being resumed keeps its archive.
    in property <bool> kept-run;
    in property <TaskView> task;
    in property <bool> password-shown;
    in property <bool> password-wrong;
    in property <string> password-name;
    in property <bool> replace-shown;
    in property <string> replace-text;
    in property <string> replace-note;
    in property <string> replace-rest;
    // The right-click menu setting exists where hatchzip-shell supports it.
    in property <bool> shell-menu-available;
    // Names the file manager where the platform has one name for it.
    in property <string> shell-menu-label;
    in-out property <bool> shell-menu-on;
    // A short message at the bottom of the window, such as the outcome of
    // changing the right-click menu.
    in property <string> notice;
    in property <bool> notice-bad;

    public function shell-explorer() -> string { return Messages.shell-explorer(); }
    public function shell-files() -> string { return Messages.shell-files(); }
    public function shell-finder() -> string { return Messages.shell-finder(); }
    public function open-archive-title() -> string { return Messages.open-archive-title(); }
    public function archives-filter() -> string { return Messages.archives-filter(); }
    public function all-files-filter() -> string { return Messages.all-files-filter(); }
    public function destination-title() -> string { return Messages.destination-title(); }
    public function menu-added() -> string { return Messages.menu-added(); }
    public function menu-removed() -> string { return Messages.menu-removed(); }
    public function no-entries() -> string { return Messages.no-entries(); }
    public function keep-archive-hint(reason: string) -> string { return Messages.keep-archive-hint(reason); }
    public function checking-space() -> string { return Messages.checking-space(); }
    public function restore-detail() -> string { return Messages.restore-detail(); }
    public function test-detail() -> string { return Messages.test-detail(); }
    public function pausing-message() -> string { return Messages.pausing-message(); }
    public function verifying-message() -> string { return Messages.verifying-message(); }
    public function paused-message() -> string { return Messages.paused-message(); }
    public function extracted-kept() -> string { return Messages.extracted-kept(); }
    public function extracted-removed() -> string { return Messages.extracted-removed(); }
    public function waiting-disk() -> string { return Messages.waiting-disk(); }

    public function reading-archive(percent: int) -> string { return Messages.reading-archive(percent); }
    public function archive-kind(name: string) -> string { return Messages.archive-kind(name); }
    public function entry-count(number: string, n: int) -> string { return Messages.entry-count(number, n); }
    public function remaining-summary(size: string, entries: string) -> string { return Messages.remaining-summary(size, entries); }
    public function uncompressed-summary(size: string) -> string { return Messages.uncompressed-summary(size); }

    public function task-heading(phase: Phase, is-test: bool, restoring: bool, name: string) -> string { return Messages.task-heading(phase, is-test, restoring, name); }

    public function task-destination(path: string) -> string { return Messages.task-destination(path); }
    public function task-amounts(done: string, total: string) -> string { return Messages.task-amounts(done, total); }
    public function task-archive-left(size: string) -> string { return Messages.task-archive-left(size); }

    public function task-test-result(n: int, count: string) -> string { return Messages.task-test-result(n, count); }

    public function task-rate(speed: string, time: string) -> string { return Messages.task-rate(speed, time); }
    public function time-short() -> string { return Messages.time-short(); }
    public function time-seconds(n: int, number: string) -> string { return Messages.time-seconds(n, number); }
    public function time-minutes(n: int, number: string) -> string { return Messages.time-minutes(n, number); }
    public function time-hours(n: int, number: string) -> string { return Messages.time-hours(n, number); }

    public function restore-held(n: int, number: string) -> string { return Messages.restore-held(n, number); }
    public function restore-result(kept: bool, held: string, path: string) -> string { return Messages.restore-result(kept, held, path); }
    public function restore-aside(n: int, number: string, path: string) -> string { return Messages.restore-aside(n, number, path); }

    public function task-resumable-error(reason: string) -> string { return Messages.task-resumable-error(reason); }

    callback open-archive();
    callback toggle-entry(int, int);
    callback password-ok(string);
    callback password-cancel();
    public function replace-question(file: string, folder: string) -> string { return Messages.replace-question(file, folder); }
    public function replace-instructions(removing: bool) -> string { return Messages.replace-instructions(removing); }
    public function replace-remaining(left: int, count: string) -> string { return Messages.replace-remaining(left, count); }

    callback replace-answer(int, bool);
    callback replace-cancel();
    callback shell-menu-toggled();
    callback give-back();
    callback verify-first-toggled();
    callback remove-archive-toggled();
    callback close-when-done-toggled();
    callback change-output();
    callback keep-free-edited(string);
    callback extract();
    callback test();
    callback pause();
    callback resume();
    callback open-folder();
    callback back();
    callback about();
    callback check-for-updates();
    callback quit();

    title: root.screen == Screen.opened ? root.archive-name + " - HatchZip" : "HatchZip";
    preferred-width: 980px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 440px;
    background: Palette.background;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Open…");
                shortcut: @keys(Control + O);
                enabled: root.task.phase == Phase.idle || root.task.phase == Phase.done;
                activated => {
                    root.open-archive();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                activated => {
                    root.quit();
                }
            }
        }
        Menu {
            title: @tr("Settings");
            if root.shell-menu-available: MenuItem {
                title: root.shell-menu-label;
                checkable: true;
                checked <=> root.shell-menu-on;
                activated => {
                    root.shell-menu-toggled();
                }
            }
            MenuItem {
                title: @tr("Verify archive before extracting");
                checkable: true;
                checked <=> root.verify-first;
                activated => {
                    root.verify-first-toggled();
                }
            }
            MenuItem {
                title: @tr("Remove the archive during extraction");
                checkable: true;
                checked <=> root.remove-archive;
                activated => {
                    root.remove-archive-toggled();
                }
            }
            MenuItem {
                title: @tr("Close the progress window when extraction completes");
                checkable: true;
                checked <=> root.close-when-done;
                activated => {
                    root.close-when-done-toggled();
                }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Check for updates");
                activated => {
                    root.check-for-updates();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About HatchZip");
                activated => {
                    root.about();
                }
            }
        }
    }

    if root.screen == Screen.empty: Rectangle {
        background: root.drop-hover ? Theme.panel : transparent;
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                DropIcon { }
            }
            Text {
                text: root.drop-hover ? @tr("Drop the archive to open it") : @tr("No archive open");
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("The archive is removed progressively during extraction, so only the space for the extracted files is required.");
                color: Theme.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                padding-top: 6px;
                Button {
                    text: @tr("Open archive…");
                    primary: true;
                    clicked => {
                        root.open-archive();
                    }
                }
            }
            Text {
                text: root.formats;
                wrap: word-wrap;
                color: Theme.faint;
                font-size: Theme.small-size;
                horizontal-alignment: center;
            }
        }
        // The same switch as in the Settings menu, where a first-time user
        // looks: most will use HatchZip from the right-click menu.
        if root.shell-menu-available: HorizontalLayout {
            y: parent.height - self.height - 20px;
            height: self.preferred-height;
            alignment: center;
            CheckBox {
                text: root.shell-menu-label;
                checked <=> root.shell-menu-on;
                toggled => {
                    root.shell-menu-toggled();
                }
            }
        }
    }

    if root.screen == Screen.loading: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Busy {
                text: root.loading-detail != "" ? root.loading-detail : @tr("Opening {}…", root.archive-name);
            }
        }
    }

    if root.screen == Screen.error: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 40px;
        Text {
            text: @tr("Unable to open {}", root.archive-name);
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.error-text;
            color: Theme.muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            Button {
                text: @tr("Open another archive…");
                clicked => {
                    root.open-archive();
                }
            }
        }
    }

    if root.screen == Screen.opened: VerticalLayout {
        // Header: what this archive is.
        VerticalLayout {
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            padding-top: 16px;
            padding-bottom: 14px;
            spacing: 4px;
            Text {
                text: root.archive-name;
                font-size: Theme.title-size;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.summary;
                color: Theme.muted;
                overflow: elide;
            }
        }
        Line { }

        HorizontalLayout {
            vertical-stretch: 1;
            EntryList {
                horizontal-stretch: 1;
                entries: root.entries;
                empty-text: root.mode == Mode.orphan ? @tr("All entries have been extracted.") : @tr("This archive is empty.");
                toggle(row, action) => { root.toggle-entry(row, action); }
            }
            VLine { }
            // The plan can outgrow a small window; its content must not
            // push the footer's controls below the window.
            space-scroll := ScrollView {
                width: 260px;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: plan-panel.preferred-height;
                plan-panel := SpacePanel {
                    width: space-scroll.visible-width;
                    plan: root.plan;
                }
            }
        }
        Line { }

        // Footer: settings and the buttons, or the run in progress.
        if root.task.phase == Phase.idle: VerticalLayout {
            padding: Theme.gutter;
            padding-top: 14px;
            spacing: 12px;

            if root.mode == Mode.resume || root.mode == Mode.orphan: Text {
                text: root.mode == Mode.resume ? @tr("This archive is partially extracted to {}.", root.output) + (root.kept-run ? @tr(" The archive is kept.") : "") : @tr("All entries have been extracted to {}. Select Finish to remove the remaining temporary files.", root.output);
                wrap: word-wrap;
                font-weight: 600;
            }

            if root.mode == Mode.fresh: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Extract to");
                    vertical-alignment: center;
                    width: 112px;
                }
                LineEdit {
                    text: root.output;
                    read-only: true;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Browse…");
                    clicked => {
                        root.change-output();
                    }
                }
            }

            if root.mode != Mode.orphan: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Reserved space");
                    vertical-alignment: center;
                    width: 112px;
                }
                LineEdit {
                    width: 72px;
                    text <=> root.keep-free;
                    input-type: decimal;
                    horizontal-alignment: right;
                    edited(text) => {
                        root.keep-free-edited(text);
                    }
                }
                Text {
                    text: root.keep-free-valid ? root.storage-unit : @tr("GB. Enter a number, such as 2 or 0.5.");
                    vertical-alignment: center;
                    color: root.keep-free-valid ? Palette.foreground : Theme.danger;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            // Lined up with the fields above, under their labels' column.
            if root.mode == Mode.fresh: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 112px;
                }
                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;
                    CheckBox {
                        text: @tr("Verify archive before extracting");
                        checked <=> root.verify-first;
                        toggled => {
                            root.verify-first-toggled();
                        }
                    }
                    CheckBox {
                        text: @tr("Remove the archive during extraction");
                        checked <=> root.remove-archive;
                        toggled => {
                            root.remove-archive-toggled();
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.mode != Mode.fresh ? "" : root.remove-archive ? @tr("The archive is removed progressively during extraction. An interrupted extraction can be resumed.") : @tr("The archive is kept unchanged, so space is required for all extracted files. An interrupted extraction can be resumed.");
                    color: Theme.muted;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.mode == Mode.fresh: Button {
                    text: @tr("Test");
                    clicked => {
                        root.test();
                    }
                }
                // A kept archive was never changed; there is nothing to restore.
                if root.mode == Mode.resume && !root.kept-run: Button {
                    text: @tr("Restore archive");
                    clicked => {
                        root.give-back();
                    }
                }
                Button {
                    text: root.mode == Mode.fresh ? @tr("Extract") : (root.mode == Mode.resume ? @tr("Resume extraction") : @tr("Finish"));
                    primary: true;
                    enabled: root.mode == Mode.orphan || (root.plan.ready && root.plan.fits && root.keep-free-valid);
                    clicked => {
                        root.extract();
                    }
                }
            }
        }

        if root.task.phase != Phase.idle: VerticalLayout {
            padding: Theme.gutter;
            padding-top: 14px;
            spacing: 10px;
            Text {
                text: root.task.heading;
                font-weight: 600;
                overflow: elide;
            }
            if root.task.phase == Phase.checking: Busy {
                text: root.task.busy;
            }
            if root.task.phase == Phase.verifying || root.task.phase == Phase.working || root.task.phase == Phase.pausing || root.task.phase == Phase.paused: Progress {
                task: root.task;
            }
            HorizontalLayout {
                spacing: 12px;
                Outcome {
                    task: root.task;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                // The archive is gone after a successful run, so Back has
                // nothing to reopen; offer the same way out as the error
                // screen instead of leaving only the folder.
                if root.task.phase == Phase.done && root.task.can-open-folder: Button {
                    text: @tr("Open another archive…");
                    clicked => {
                        root.open-archive();
                    }
                }
                TaskButtons {
                    task: root.task;
                    closable: false;
                    pause => {
                        root.pause();
                    }
                    resume => {
                        root.resume();
                    }
                    open-folder => {
                        root.open-folder();
                    }
                    back => {
                        root.back();
                    }
                    give-back => {
                        root.give-back();
                    }
                }
            }
        }
    }

    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        // Above the footer's buttons and the right-click switch.
        y: 16px;
        width: min(notice-text.preferred-width + 32px, parent.width - 32px);
        height: notice-text.preferred-height + 20px;
        background: Palette.alternate-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        notice-text := Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.notice;
            wrap: word-wrap;
            vertical-alignment: center;
            color: root.notice-bad ? Theme.danger : Palette.foreground;
        }
    }

    if root.password-shown: PasswordPrompt {
        name: root.password-name;
        wrong: root.password-wrong;
        ok(text) => {
            root.password-ok(text);
        }
        cancel => {
            root.password-cancel();
        }
    }

    if root.replace-shown: ReplacePrompt {
        text: root.replace-text;
        note: root.replace-note;
        rest: root.replace-rest;
        answer(choice, rest) => {
            root.replace-answer(choice, rest);
        }
        cancel => {
            root.replace-cancel();
        }
    }
}
