import { Palette } from "std-widgets.slint";
import { Messages } from "messages.slint";
import { Theme } from "theme.slint";
import { Phase, PlanView, TaskView, Progress, Outcome, Busy, TaskButtons, PasswordPrompt, ReplacePrompt, SpaceVerdict, SpaceNotes } from "parts.slint";

// The small window a right-click opens. It does one thing and closes.
export component TaskWindow inherits Window {
    in property <TaskView> task;
    in property <PlanView> plan;
    in property <bool> password-shown;
    in property <bool> password-wrong;
    in property <string> password-name;
    in property <bool> replace-shown;
    in property <string> replace-text;
    in property <string> replace-note;
    in property <string> replace-rest;

    callback pause();
    callback resume();
    callback open-folder();
    callback dismiss();
    callback give-back();
    callback lower-reserve();
    callback password-ok(string);
    callback password-cancel();
    callback replace-answer(int, bool);
    callback replace-cancel();

    title: root.task.heading;
    preferred-width: 480px;
    // Tall enough for the longest state and the password prompt, so the
    // window never has to grow while it is on screen. The extra line for
    // several archives ("Archive 2 of 3") is counted.
    preferred-height: 270px;
    min-width: 420px;
    background: Palette.background;

    VerticalLayout {
        padding: Theme.gutter;
        spacing: 12px;

        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.task.heading;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.task.detail;
                color: Theme.muted;
                overflow: elide;
            }
            if root.task.step != "": Text {
                text: root.task.step;
                color: Theme.muted;
                overflow: elide;
            }
            if root.task.space != "": Text {
                text: root.task.space;
                color: Theme.muted;
                overflow: elide;
            }
        }

        if root.task.phase == Phase.checking: Busy {
            text: root.task.busy;
        }
        if root.task.phase == Phase.verifying || root.task.phase == Phase.working || root.task.phase == Phase.pausing || root.task.phase == Phase.paused: Progress {
            task: root.task;
        }
        if root.task.phase == Phase.no-space: SpaceVerdict {
            plan: root.plan;
        }
        if root.task.phase == Phase.no-space: Text {
            text: !root.task.lower-reserve
                ? @tr("Available: {}. Required: {}, plus {} reserved.", root.plan.free, root.plan.needed, root.plan.keep)
                : root.task.reserve-amount == ""
                    ? @tr("The reserve is all that stands in the way: {} is needed and {} is available, so it can run without one, with {} left once it finishes.", root.plan.needed, root.plan.free, root.plan.left)
                    : @tr("The reserve is all that stands in the way: {} is needed and {} is available, so it can run with {} reserved, with {} left once it finishes.", root.plan.needed, root.plan.free, root.task.reserve-amount, root.plan.left);
            color: Theme.muted;
            wrap: word-wrap;
        }
        Outcome {
            task: root.task;
        }
        if root.task.phase == Phase.no-space: SpaceNotes {
            plan: root.plan;
        }

        Rectangle {
            vertical-stretch: 1;
        }

        TaskButtons {
            task: root.task;
            closable: true;
            offer-reserve: true;
            pause => {
                root.pause();
            }
            resume => {
                root.resume();
            }
            open-folder => {
                root.open-folder();
            }
            close => {
                root.dismiss();
            }
            give-back => {
                root.give-back();
            }
            lower-reserve => {
                root.lower-reserve();
            }
        }
    }

    if root.password-shown: PasswordPrompt {
        name: root.password-name;
        wrong: root.password-wrong;
        ok(text) => {
            root.password-ok(text);
        }
        cancel => {
            root.password-cancel();
        }
    }

    if root.replace-shown: ReplacePrompt {
        text: root.replace-text;
        note: root.replace-note;
        rest: root.replace-rest;
        answer(choice, rest) => {
            root.replace-answer(choice, rest);
        }
        cancel => {
            root.replace-cancel();
        }
    }
}
