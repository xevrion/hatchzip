import { AboutSlint, Button, Palette } from "std-widgets.slint";
import { Theme, Line } from "theme.slint";

export component AboutWindow inherits Window {
    in property <string> version;
    callback open-link();
    callback dismiss();

    title: @tr("About HatchZip");
    preferred-width: 420px;
    min-width: 380px;
    background: Palette.background;

    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            Image {
                // Drawn on a 16 px grid, so 48 keeps every edge sharp.
                source: @image-url("../../../assets/icon/png/hatchzip-48.png");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "HatchZip";
                    font-size: 20px;
                    font-weight: 600;
                }
                Text {
                    text: @tr("Version {}", root.version);
                    color: Theme.muted;
                }
            }
        }
        Text {
            text: @tr("Extracts large archives in place. The archive is removed progressively during extraction, so only the space for the extracted files is required.");
            wrap: word-wrap;
        }
        Text {
            text: @tr("Licensed under MIT or Apache-2.0");
            color: Theme.muted;
            wrap: word-wrap;
        }
        link := Text {
            text: "github.com/xevrion/hatchzip";
            color: Palette.accent-background;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open-link();
                }
            }
        }
        Rectangle {
            height: 6px;
        }
        Line { }
        AboutSlint {
            max-height: 160px;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: @tr("Close");
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
