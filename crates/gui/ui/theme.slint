import { Palette } from "std-widgets.slint";

// The few colors the style's palette doesn't have. Everything else comes from
// `Palette`, so the app follows the system's light or dark setting, or the
// one chosen in Settings.
export global Theme {
    // Choosing "System" again in Settings sets the scheme to `unknown`, which
    // the palette resolves against the system without saying which it got,
    // so its background tells.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark || (Palette.color-scheme == ColorScheme.unknown && Palette.background.to-hsv().value < 0.5);
    out property <brush> line: dark ? #ffffff1f : #0000001a;
    out property <brush> muted: dark ? #ffffffa6 : #000000a0;
    out property <brush> faint: dark ? #ffffff66 : #00000066;
    out property <brush> danger: dark ? #ff99a4 : #c42b1c;
    out property <brush> panel: dark ? #ffffff08 : #00000005;
    out property <brush> track: dark ? #ffffff1f : #00000014;
    // Line icons that are controls, such as the gear: stronger than muted
    // text, so a thin outline still reads at 1x.
    out property <brush> icon: dark ? #ffffffcc : #000000b8;
    out property <brush> success: dark ? #6ccb5f : #0f7b0f;
    // The selected tree row: a tint of the accent while the list has the
    // keyboard, the track's gray once it doesn't.
    out property <brush> selected: dark ? #60cdff29 : #005fb81f;
    // Under the cards of prompts, so they lift off the dimmed window.
    out property <color> shadow: dark ? #00000080 : #00000040;
    out property <length> card-radius: 10px;
    // Behind a prompt, so the window reads as paused.
    out property <brush> scrim: dark ? #000000a0 : #00000059;
    out property <length> gutter: 20px;
    out property <length> title-size: 18px;
    // Set from Rust for the language on screen (`locale::style`). A family
    // the system has for the script, since the fallback some systems pick
    // lacks glyphs (Simplified Chinese on Windows) or a bold weight. Empty
    // keeps the style's own font.
    in property <string> font-family;
    // Devanagari draws smaller than Latin at the same size and its vowel
    // signs crowd wrapped lines, so small text is a size up for it.
    in property <length> script-boost;
    // The menu bar is drawn inside the window, not by the system, so it
    // needs an edge between it and the content.
    in property <bool> menu-edge;
    out property <length> small-size: 12px + script-boost;
}

export component Line inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component VLine inherits Rectangle {
    width: 1px;
    background: Theme.line;
}

// A thin bar: how much of what is free the run uses.
export component Meter inherits Rectangle {
    in property <float> value;
    in property <bool> bad;
    height: 6px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0;
        // A sliver stays visible for runs too small to show at scale.
        width: root.value > 0 ? max(root.height, parent.width * clamp(root.value, 0, 1)) : 0;
        border-radius: 3px;
        background: root.bad ? Theme.danger : Palette.accent-background;
    }
}

// A path that can't be edited, in a field's frame. One line shows the end
// of the path, the part that names the file or folder, behind an ellipsis
// when it is too long; a cut-off start is easier to do without.
export component PathLine inherits Rectangle {
    in property <string> text;
    in property <string> label;
    property <bool> long: line.preferred-width > self.width - 16px;
    min-width: 120px;
    min-height: line.preferred-height + 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
    accessible-role: text;
    accessible-label: root.label;
    accessible-value: root.text;

    if root.long: Text {
        x: 8px;
        height: parent.height;
        text: "…";
        color: Theme.muted;
        vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        x: root.long ? 20px : 8px;
        y: 0;
        width: parent.width - self.x - 8px;
        height: parent.height;
        clip: true;
        line := Text {
            x: min(0px, parent.width - self.width);
            width: self.preferred-width;
            height: parent.height;
            text: root.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The same frame for a path that wraps, so all of it shows however narrow
// the window is.
export component PathBlock inherits Rectangle {
    in property <string> text;
    in property <string> label;
    min-width: 120px;
    min-height: max(28px, body.preferred-height + 12px);
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
    accessible-role: text;
    accessible-label: root.label;
    accessible-value: root.text;

    body := Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 20px;
        height: self.preferred-height;
        text: root.text;
        wrap: char-wrap;
        accessible-role: none;
    }
}

// Outline icons drawn as paths, so they stay sharp at any scale and render
// the same in the software renderer.
export component FolderIcon inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: Theme.muted;
    stroke-width: 1.1px;
    fill: transparent;
    commands: "M 1.5 3.5 L 6 3.5 L 7.5 5 L 14.5 5 L 14.5 13 L 1.5 13 Z";
}

export component FileIcon inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: Theme.faint;
    stroke-width: 1.1px;
    fill: transparent;
    commands: "M 3.5 1.5 L 9.5 1.5 L 12.5 4.5 L 12.5 14.5 L 3.5 14.5 Z M 9.5 1.5 L 9.5 4.5 L 12.5 4.5";
}

// A tray with a downward arrow: the empty state's drop target.
export component DropIcon inherits Path {
    width: 40px;
    height: 40px;
    viewbox-width: 40;
    viewbox-height: 40;
    stroke: Theme.faint;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 20 6 L 20 24 M 13 17 L 20 24 L 27 17 M 6 24 L 6 33 L 34 33 L 34 24";
}
