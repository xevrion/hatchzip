msgstr "可用"

msgid "Required, archive removed"
msgstr "所需（删除压缩包时）"

msgid "Required, archive kept"
msgstr "所需（保留压缩包时）"

msgid "Reserved"
msgstr "预留"

msgid "Available after extraction"
msgstr "解压后可用"

msgid "Restore complete"
msgstr "恢复完成"

msgid "Restore failed"
msgstr "恢复失败"

