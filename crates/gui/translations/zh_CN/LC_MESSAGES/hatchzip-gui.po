msgid "Name"
msgstr "名称"

msgid "Size"
msgstr "大小"

msgid "File"
msgstr "文件"

msgid "Open…"
msgstr "打开…"

msgid "Quit"
msgstr "退出"

msgid "Settings"
msgstr "设置"

msgid "Verify archive before extracting"
msgstr "解压前校验压缩包"

msgid "Remove the archive during extraction"
msgstr "解压时逐步删除压缩包"

msgid "Close the progress window when extraction completes"
msgstr "解压完成后关闭进度窗口"

msgid "Language"
msgstr "语言"

msgid "Use the system language"
msgstr "使用系统语言"

msgid "Help"
msgstr "帮助"

msgid "Check for updates"
msgstr "检查更新"

msgid "About HatchZip"
msgstr "关于 HatchZip"

msgid "Version {}"
msgstr "版本 {}"

msgid "Extracts large archives in place. The archive is removed progressively during extraction, so only the space for the extracted files is required."
msgstr "原地解压大型压缩包。解压时逐步删除压缩包，因此只需要容纳解压文件的空间。"

msgid "Licensed under MIT or Apache-2.0"
msgstr "使用 MIT 或 Apache-2.0 许可证授权"

msgid "Drop the archive to open it"
msgstr "松开以打开压缩包"

msgid "No archive open"
msgstr "未打开压缩包"

msgid "The archive is removed progressively during extraction, so only the space for the extracted files is required."
msgstr "解压过程中会逐步删除压缩包，因此只需为解压出的文件预留空间。"

msgid "Open archive…"
msgstr "打开压缩包…"

msgid "Open another archive…"
msgstr "打开其他压缩包…"

msgid "All entries have been extracted."
msgstr "所有条目均已解压。"

msgid "This archive is empty."
msgstr "此压缩包为空。"

msgid "Extract to"
msgstr "解压到"

msgid "Browse…"
msgstr "浏览…"

msgid "Reserved space"
msgstr "预留空间"

msgid "GB. Enter a number, such as 2 or 0.5."
msgstr "GB。请输入数字，例如 2 或 0.5。"

msgid "The archive is removed progressively during extraction. An interrupted extraction can be resumed."
msgstr "解压过程中会逐步删除压缩包。解压中断后可以继续。"

msgid "The archive is kept unchanged, so space is required for all extracted files. An interrupted extraction can be resumed."
msgstr "压缩包保持不变，因此需要为所有解压出的文件预留空间。解压中断后可以继续。"

msgid "Test"
msgstr "测试"

msgid "Restore archive"
msgstr "恢复压缩包"

msgid "Extract"
msgstr "解压"

msgid "Resume extraction"
msgstr "继续解压"

msgid "Finish"
msgstr "完成"

msgid "Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, tar.bz2, tar.xz, tar.zst, and split archives."
msgstr "也可以将压缩包拖到此窗口。支持的格式：ZIP、7z、tar、tar.gz、tar.bz2、tar.xz、tar.zst 和分卷压缩包。"

msgid "Or drag an archive onto this window. Supported formats: ZIP, 7z, tar, tar.gz, tar.bz2, tar.xz, tar.zst, RAR, and split archives."
msgstr "也可以将压缩包拖到此窗口。支持的格式：ZIP、7z、tar、tar.gz、tar.bz2、tar.xz、tar.zst、RAR 和分卷压缩包。"

msgid "Opening {}…"
msgstr "正在打开 {}…"

msgid "Unable to open {}"
msgstr "无法打开 {}"

msgid "This archive is partially extracted to {}."
msgstr "此压缩包已部分解压到 {}。"

msgid " The archive is kept."
msgstr " 压缩包已保留。"

msgid "All entries have been extracted to {}. Select Finish to remove the remaining temporary files."
msgstr "所有条目均已解压到 {}。选择“完成”以删除剩余的临时文件。"

msgid "Show in the Explorer context menu"
msgstr "在文件资源管理器右键菜单中显示"

msgid "Show in the file manager's context menu"
msgstr "在文件管理器右键菜单中显示"

msgid "Show in the Finder context menu"
msgstr "在“访达”右键菜单中显示"

