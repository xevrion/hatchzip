msgstr[0] "测试通过：已校验 {} 个条目。"

msgid "'{}' already exists in {}."
msgstr "{1} 中已存在“{0}”。"

msgid "Replace deletes the existing file when the extraction completes. Skip keeps it, and the archive's copy is not kept. Keep both keeps it and adds the archive's copy with a number after its name."
msgstr "“替换”会在解压完成时删除现有文件。“跳过”会保留现有文件，但不保留压缩包中的副本。“保留两者”会保留现有文件，同时添加压缩包中的副本，并在其名称后加上编号。"

msgid "Replace deletes the existing file when the extraction completes. Skip keeps it. Keep both keeps it and adds the archive's copy with a number after its name."
msgstr "“替换”会在解压完成时删除现有文件。“跳过”会保留现有文件。“保留两者”会保留现有文件，同时添加压缩包中的副本，并在其名称后加上编号。"

msgid "Do the same for the next file"
msgid_plural "Do the same for the next {} files"
msgstr[0] "对接下来的 {} 个文件执行相同操作"

