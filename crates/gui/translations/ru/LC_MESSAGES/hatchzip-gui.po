msgstr "Архив восстановлен. Он содержит {}. Извлечённые файлы остаются в {}."

msgid "1 replaced file remains in {1}, since the file extracted at its path is no longer in the archive."
msgid_plural "{} replaced files remain in {}, since the files extracted at their paths are no longer in the archive."
msgstr[0] "{0} заменённый файл остался в {1}, так как файл, извлечённый по этому пути, больше не находится в архиве."
msgstr[1] "{0} заменённых файла остались в {1}, так как файлы, извлечённые по их путям, больше не находятся в архиве."
msgstr[2] "{0} заменённых файлов остались в {1}, так как файлы, извлечённые по их путям, больше не находятся в архиве."

