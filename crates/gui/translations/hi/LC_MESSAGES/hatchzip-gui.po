msgid "Restore failed"
msgstr "पुनर्स्थापन विफल हुआ"

msgid "Restoring {}"
msgstr "{} पुनर्स्थापित किया जा रहा है"

msgid "Test complete"
msgstr "जाँच पूरी हुई"

msgid "Test failed"
msgstr "जाँच विफल हुई"

msgid "Testing {}"
msgstr "{} की जाँच हो रही है"

msgid "Extraction complete"
msgstr "एक्सट्रैक्शन पूरा हुआ"

msgid "Extraction paused"
