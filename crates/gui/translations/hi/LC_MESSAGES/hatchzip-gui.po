msgid " The archive is kept."
msgstr " आर्काइव रखा गया है।"

msgid "All entries have been extracted to {}. Select Finish to remove the remaining temporary files."
msgstr "सभी प्रविष्टियाँ {} में एक्सट्रैक्ट हो चुकी हैं। बची हुई अस्थायी फ़ाइलें हटाने के लिए पूरा करें चुनें।"

msgid "Show in the Explorer context menu"
msgstr "Explorer के संदर्भ मेन्यू में दिखाएँ"

msgid "Show in the file manager's context menu"
