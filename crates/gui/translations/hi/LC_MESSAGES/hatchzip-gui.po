msgid "Name"
msgstr "नाम"

msgid "Size"
msgstr "आकार"

msgid "File"
msgstr "फ़ाइल"

msgid "Open…"
msgstr "खोलें…"

msgid "Quit"
msgstr "बंद करें"

msgid "Settings"
msgstr "सेटिंग्स"

msgid "Verify archive before extracting"
msgstr "एक्सट्रैक्ट करने से पहले आर्काइव की जाँच करें"

msgid "Remove the archive during extraction"
msgstr "एक्सट्रैक्शन के दौरान आर्काइव हटाएँ"

msgid "Close the progress window when extraction completes"
msgstr "एक्सट्रैक्शन पूरा होने पर प्रगति विंडो बंद करें"

msgid "Help"
msgstr "मदद"

