<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers": the setup and the MSI, built
  from the programs signed with "programs". The release workflow uploads
  them as the GitHub artifact signing-installers, a zip with both at its
  root.

  SignPath signs the setup only if its product name and version are the ones
  the workflow passes, and the MSI only if its summary information names it
  the HatchZip installer by Yash Bavadiya (hatchzip.wxs), as SignPath
  Foundation requires. Inno Setup writes the setup's name and version over
  fixed-length placeholders, so they end in spaces; the workflow checks
  that, trimmed, they are HatchZip and the release's version, and passes
  them exactly as "innoProductName" and "innoProductVersion"
  (packaging/windows/inno-version-info.ps1).

  This file is the copy to paste into the SignPath project. See "Windows:
  signing" in packaging/README.md.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="innoProductName" required="true" />
    <parameter name="innoProductVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="HatchZip-x64-setup.exe" product-name="${innoProductName}" product-version="${innoProductVersion}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="HatchZip-x64.msi" subject="HatchZip installer" author="Yash Bavadiya">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
