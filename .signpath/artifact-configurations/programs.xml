<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "programs": the two programs and the
  Explorer menu DLL, signed before they are packaged, so the zip, the setup
  and the MSI all carry signed copies (hz.exe is a copy of hatchzip.exe).
  The release workflow uploads them as the GitHub artifact signing-programs,
  a zip with all three at its root.
  SignPath reads artifact configurations from the project, not from this
  repository: this file is the copy to paste there. See "Windows: signing"
  in packaging/README.md.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="hatchzip.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="hatchzip-gui.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="hatchzip_shell_ext.dll">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
